# ============================================================
# ds-profile — Environment Configuration
# Infrastructure feature flags ONLY. All user settings are in DB.
# Copy to .env for local development. Never commit .env.
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://dsprofile:dsprofile@localhost:5432/dsprofile

# Auth
# Set to true in dev to bypass all auth. Set to false in prod.
AUTH_DISABLED=true
SUPABASE_JWT_SECRET=

# Storage backend: minio (dev) | supabase (prod)
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=profile-assets

# PDF Parser backend: local (dev) | cloud (prod)
UNSTRUCTURED_BACKEND=local
UNSTRUCTURED_BASE_URL=http://localhost:8001
UNSTRUCTURED_API_KEY=

# Dev passthrough user (used when AUTH_DISABLED=true)
DEFAULT_USER_ID=dev-user

# Frontend
VITE_API_URL=http://localhost:8000/api/v1
