# ============================================================
# ds-profile — Environment Configuration
# Infrastructure feature flags ONLY. All user settings are in DB.
# Copy to .env for local development. Never commit .env.
# ============================================================

# Database
DATABASE_URL=postgresql+asyncpg://dsprofile:dsprofile@localhost:15432/dsprofile
POSTGRES_USER=dsprofile
POSTGRES_PASSWORD=dsprofile
POSTGRES_DB=dsprofile

# Auth
# SECURITY: AUTH_DISABLED defaults to false in code (prod-safe).
# Explicitly set to true ONLY for local development — never in prod.
AUTH_DISABLED=true
SUPABASE_JWT_SECRET=

# Storage backend: minio (dev) | supabase (prod)
STORAGE_BACKEND=minio
STORAGE_ENDPOINT=http://localhost:19000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=profile-assets

# PDF Parser backend: local (dev) | cloud (prod)
UNSTRUCTURED_BACKEND=local
UNSTRUCTURED_BASE_URL=http://localhost:18001
UNSTRUCTURED_API_KEY=

# Dev passthrough user (used when AUTH_DISABLED=true)
DEFAULT_USER_ID=dev-user

# Frontend
VITE_API_URL=http://localhost:18000/api/v1

# ─── Port overrides (optional — these are project defaults) ───────────────────
# Uncomment to override. These are already set to project-specific values
# to avoid conflicts with other dsapps projects on the same machine.
#
# FRONTEND_PORT=13000
# FRONTEND_DEV_PORT=15173
# BACKEND_PORT=18000
# DB_PORT=15432
# STORAGE_PORT=19000
# STORAGE_CONSOLE_PORT=19001
# PARSER_PORT=18001
